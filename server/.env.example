# ---- Core ---------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Required in production. In development a random secret is generated per run.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional. Without it the server runs in demo mode: the Inama v1 API uses an
# in-memory store and the original AgriAI web routes answer 503.
MONGODB_URI=

# ---- AI & weather (both optional — the API falls back to the knowledge base / demo weather)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
WEATHER_API_KEY=

# ---- AgriAI web client (unchanged) ---------------------------------------------
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- Inama v1 -----------------------------------------------------------------
# Languages the API answers in. Only "en" content ships in the MVP.
INAMA_LANGUAGES=en
INAMA_DEFAULT_LANGUAGE=en
# Defaults to ../shared/knowledge and ../shared/content in this repository.
INAMA_KNOWLEDGE_DIR=
INAMA_CONTENT_DIR=
INAMA_OTP_TTL_SECONDS=300
# Development only: return OTP codes in the API response (there is no SMS gateway yet).
INAMA_EXPOSE_OTP=true
INAMA_TOKEN_TTL_SECONDS=2592000
INAMA_MAX_IMAGE_BYTES=8388608
INAMA_DEMO_EXPERT_REPLY_SECONDS=90
INAMA_DEFAULT_PLACE=Kigali, RW
# Port for the zero-dependency dev server (npm run dev:inama)
INAMA_PORT=5055
